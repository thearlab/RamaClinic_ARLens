  SetupScript:
    code: ""
  Description: |
    UI Scroll View is a custom component that allows one to scroll one screen transform within the bounds of another.  
    It can be used when content that takes up a lot of space needs to be displayed in a small area - for example a map, a long block of text or a long list of items.
    
    content: ScreenTransform - content screen transform;
    
    useMask: boolean - use masking component;
    
    dragX: boolean  - enable/disable horizontal scroll;
    
    dragY: boolean - enable/disable vertical scroll;
        
    scrollType : UIScrollView.ScrollType - set the scroll type;
    
    elasticity : number - set elasticity value;
    
    inertia : number - set inertia value;
    
    scrollBarType : UIScrollView.ScrollBarType;
    
    scrollBarWidth : number - a width of a scroll bar;
    
    enableHorizontalScrollBar : boolean - enable/disable hirizontal scroll bar;
    
    enableVerticalScrollBar: boolean - enable/disable vertical scroll bar;
    
    positionNormalizedX: number - set normalized position x [-1, 1]
    
    positionNormalizedY: number - set normalized position y [-1, 1]

